# ---- Required -----------------------------------------------------------------------------
# Pangolin Integration API, as reachable from the Gatus host (port 3003 of the pangolin container).
PANGOLIN_API_URL=http://192.168.1.10:3003/v1
# Organization id, as shown in the Pangolin dashboard URL.
PANGOLIN_ORG_ID=my-org
# Read-only API key (Organization > API Keys), format ID.SECRET.
# Gatus needs the same value in ITS environment: the generated config references ${PANGOLIN_API_KEY}.
PANGOLIN_API_KEY=

# Host folder Gatus loads its configuration from (mounted as /config in both containers).
GATUS_CONFIG_DIR=/opt/gatus/config

# ---- Alerts -------------------------------------------------------------------------------
# Comma separated Gatus alert providers; each must be configured under `alerting:` in Gatus.
GATUS_ALERT_TYPES=
ALERT_FAILURE_THRESHOLD=2
ALERT_SUCCESS_THRESHOLD=1

# ---- Optional -----------------------------------------------------------------------------
# GATUS_GROUP=Pangolin
# SYNC_INTERVAL=300
# CHECK_INTERVAL=60s
# FAIL_ON_UNKNOWN=false
# RESOURCE_INCLUDE=*.example.com
# RESOURCE_EXCLUDE=*.dev.example.com,Test*
# GATUS_API_ENDPOINT=true
# PANGOLIN_TLS_VERIFY=true
# OUTPUT_FILE=/config/pangolin.yaml
# HTTP_TIMEOUT=15
# LOG_LEVEL=INFO
